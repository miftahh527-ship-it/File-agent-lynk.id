   "sentences": [
    {
     "text": "Wah, perjalanan kita hari ini seru banget!",
     "para": 0,
     "start": 0.45,
     "end": 3.48
    },
    {
     "text": "Kita sudah keliling dari Merkurius yang panas-dingin, sampai Neptunus yang super berangin.",
     "para": 0,
     "start": 3.48,
     "end": 9.38
    },
    {
     "text": "Kalau kamu suka video ini, kasih jempol, subscribe, dan tulis di komentar: planet apa yang mau kita bahas lebih dalam di video berikutnya?",
     "para": 1,
     "start": 9.38,
