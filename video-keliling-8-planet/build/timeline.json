   "sentences": [
    {
     "text": "Coba tebak, mana yang lebih lama: satu hari, atau satu tahun?",
     "para": 0,
     "start": 0.45,
     "end": 5.37
    },
    {
     "text": "Di Venus, jawabannya... satu hari!",
     "para": 0,
     "start": 5.37,
     "end": 8.71
    },
    {
     "text": "Venus berputar sangat pelan.",
     "para": 1,
     "start": 8.71,
     "end": 10.87
    },
    {
     "text": "Satu kali putaran butuh 243 hari Bumi.",
     "para": 1,
     "start": 10.87,
     "end": 14.76
    },
    {
     "text": "Padahal untuk mengelilingi Matahari, Venus cuma butuh sekitar 225 hari Bumi.",
     "para": 1,
     "start": 14.76,
     "end": 21.04
    },
    {
     "text": "Jadi satu harinya lebih lama dari satu tahunnya!",
     "para": 1,
     "start": 21.04,
     "end": 24.53
    },
    {
     "text": "Venus juga planet paling panas, suhunya lebih dari 460 derajat Celsius.",
     "para": 2,
     "start": 24.53,
     "end": 30.56
    },
    {
     "text": "Lho, kok bukan Merkurius?",
     "para": 2,
     "start": 30.56,
     "end": 32.6
    },
    {
     "text": "Karena awan tebal Venus memerangkap panas, seperti mobil yang diparkir di bawah terik matahari dengan kaca tertutup.",
     "para": 2,
     "start": 32.6,
     "end": 39.39
    },
    {
     "text": "Bonus: Venus berputar ke arah berlawanan dengan Bumi.",
     "para": 3,
     "start": 39.39,
     "end": 43.13
    },
    {
     "text": "Di sana, Matahari terbit dari barat!",
     "para": 3,
     "start": 43.13,
     "end": 45.97
    }
   ],
