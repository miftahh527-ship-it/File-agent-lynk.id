   "sentences": [
    {
     "text": "Ada planet yang satu harinya... lebih lama dari satu tahunnya!",
     "para": 0,
     "start": 0.8,
     "end": 4.98
    },
    {
     "text": "Ada planet yang bisa... mengapung di air!",
     "para": 1,
     "start": 4.98,
     "end": 8.22
    },
    {
     "text": "Dan ada gunung yang tingginya tiga kali Gunung Everest!",
     "para": 2,
     "start": 8.22,
     "end": 11.81
    },
    {
     "text": "Halo, teman-teman penjelajah!",
     "para": 3,
     "start": 11.81,
     "end": 13.66
    },
    {
     "text": "Hari ini kita naik roket imajinasi dan keliling delapan planet di tata surya kita.",
     "para": 3,
     "start": 13.66,
     "end": 19.03
    },
    {
     "text": "Semua fakta di video ini diambil dari data NASA dan lembaga antariksa dunia.",
     "para": 3,
     "start": 19.03,
     "end": 23.97
    },
    {
     "text": "Jadi bukan hoaks, ya!",
     "para": 3,
     "start": 23.97,
     "end": 25.55
    },
    {
     "text": "Siapkan pensil dan kertas, karena di akhir video ada kuis seru.",
     "para": 4,
     "start": 25.55,
     "end": 29.46
    },
    {
     "text": "Yuk, pasang sabuk pengaman... tiga... dua... satu... meluncur!",
     "para": 4,
     "start": 29.46,
     "end": 34.96
    }
   ],
