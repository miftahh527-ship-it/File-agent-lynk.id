   ],
   "sentences": [
    {
     "text": "Sebelum ke planet, kenalan dulu sama bosnya: Matahari!",
     "para": 0,
     "start": 0.45,
     "end": 4.69
    },
    {
     "text": "Tahu nggak, Matahari itu besaaar banget.",
     "para": 0,
     "start": 4.69,
     "end": 7.65
    },
    {
     "text": "Kalau Matahari itu kosong di dalamnya, kira-kira 1,3 juta Bumi bisa masuk ke dalamnya!",
     "para": 0,
     "start": 7.65,
     "end": 14.33
    },
    {
     "text": "Lebarnya saja sekitar 109 kali lebar Bumi.",
     "para": 1,
     "start": 14.33,
     "end": 18.15
    },
    {
     "text": "Wow!",
     "para": 1,
     "start": 18.15,
     "end": 19.49
    },
    {
     "text": "Terus, cahaya Matahari yang kamu lihat pagi ini?",
     "para": 2,
     "start": 19.49,
     "end": 22.49
    },
    {
     "text": "Itu butuh sekitar 8 menit untuk sampai ke Bumi.",
     "para": 2,
     "start": 22.49,
     "end": 25.67
    },
    {
     "text": "Jadi kamu sebenarnya melihat Matahari 8 menit yang lalu!",
     "para": 2,
     "start": 25.67,
     "end": 29.76
    },
    {
     "text": "Ingat ya, jangan pernah melihat Matahari langsung dengan mata, bisa merusak mata.",
     "para": 3,
     "start": 29.76,
     "end": 34.99
    },
    {
     "text": "Nah, Matahari punya delapan planet yang setia mengelilinginya.",
     "para": 4,
     "start": 34.99,
     "end": 39.06
    },
    {
     "text": "Kita mulai dari yang paling dekat!",
     "para": 4,
     "start": 39.06,
     "end": 41.17
    }
   ],
