     "start": 5.73,
     "end": 12.77
    }
   ],
   "sentences": [
    {
     "text": "Saatnya kuis!",
     "para": 0,
     "start": 0.45,
     "end": 1.9
    },
    {
     "text": "Jawab dalam hati, atau tulis di kolom komentar ya!",
     "para": 0,
     "start": 1.9,
     "end": 5.73
    },
    {
     "text": "Soal pertama: planet mana yang paling panas?",
     "para": 1,
     "start": 5.73,
     "end": 9.36
    },
    {
     "text": "A, Merkurius.",
     "para": 1,
     "start": 9.36,
     "end": 11.16
    },
    {
     "text": "B, Venus.",
     "para": 1,
     "start": 11.16,
     "end": 12.77
    }
   ],
   "planet_idx": 8,
   "timer_start": 13.27
  },
