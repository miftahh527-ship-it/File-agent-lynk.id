   "sentences": [
    {
     "text": "Planet mana yang siangnya panas membara, tapi malamnya beku banget?",
     "para": 0,
     "start": 0.45,
     "end": 5.12
    },
    {
     "text": "Jawabannya: Merkurius!",
     "para": 0,
     "start": 5.12,
     "end": 7.46
    },
    {
     "text": "Merkurius adalah planet paling dekat dengan Matahari.",
     "para": 1,
     "start": 7.46,
     "end": 10.85
    },
    {
     "text": "Siang hari, suhunya bisa mencapai 430 derajat Celsius.",
     "para": 1,
     "start": 10.85,
     "end": 15.86
    },
    {
     "text": "Tapi malam hari, bisa turun sampai minus 180 derajat!",
     "para": 1,
     "start": 15.86,
     "end": 20.53
    },
    {
     "text": "Kenapa begitu?",
     "para": 1,
     "start": 20.53,
     "end": 21.73
    },
    {
     "text": "Karena Merkurius hampir tidak punya atmosfer untuk menyimpan panas.",
     "para": 1,
     "start": 21.73,
     "end": 25.88
    },
    {
     "text": "Satu tahun di Merkurius cuma 88 hari Bumi.",
     "para": 2,
     "start": 25.88,
     "end": 29.76
    },
    {
     "text": "Kalau kamu tinggal di sana, kamu ulang tahun kira-kira tiap tiga bulan.",
     "para": 2,
     "start": 29.76,
     "end": 35.14
    },
    {
     "text": "Asyik, kuenya banyak!",
     "para": 2,
     "start": 35.14,
     "end": 36.45
    },
    {
     "text": "Oh iya, Merkurius tidak punya bulan sama sekali.",
     "para": 3,
     "start": 36.45,
     "end": 39.76
    },
    {
     "text": "Lanjut ke tetangga sebelah yang lebih panas lagi!",
     "para": 4,
     "start": 39.76,
     "end": 42.69
    }
   ],
