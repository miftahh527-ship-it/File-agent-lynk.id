   "sentences": [
    {
     "text": "Kenapa Mars disebut Planet Merah?",
     "para": 0,
     "start": 0.45,
     "end": 2.73
    },
    {
     "text": "Jawabannya ternyata... karat!",
     "para": 0,
     "start": 2.73,
     "end": 5.65
    },
    {
     "text": "Tanah Mars mengandung banyak besi oksida, alias karat.",
     "para": 1,
     "start": 5.65,
     "end": 9.19
    },
    {
     "text": "Sama seperti paku yang dibiarkan basah, lama-lama jadi merah kecokelatan.",
     "para": 1,
     "start": 9.19,
     "end": 13.91
    },
    {
     "text": "Debu karat inilah yang membuat Mars terlihat merah.",
     "para": 1,
     "start": 13.91,
     "end": 17.35
    },
    {
     "text": "Mars juga punya gunung berapi terbesar di tata surya, namanya Olympus Mons.",
     "para": 2,
     "start": 17.35,
     "end": 22.55
    },
    {
     "text": "Tingginya sekitar tiga kali Gunung Everest, gunung tertinggi di Bumi!",
     "para": 2,
     "start": 22.55,
     "end": 27.11
    },
    {
     "text": "Mars punya dua bulan kecil, namanya Phobos dan Deimos.",
     "para": 3,
     "start": 27.11,
     "end": 31.29
    }
   ],
