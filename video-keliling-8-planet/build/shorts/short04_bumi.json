   "sentences": [
    {
     "text": "Dari delapan planet, cuma satu yang sejauh ini diketahui punya kehidupan.",
     "para": 0,
     "start": 0.45,
     "end": 5.2
    },
    {
     "text": "Yap, rumah kita sendiri: Bumi!",
     "para": 0,
     "start": 5.2,
     "end": 8.05
    },
    {
     "text": "Sebagian besar permukaan Bumi, sekitar 71 persen, tertutup air.",
     "para": 1,
     "start": 8.05,
     "end": 12.78
    },
    {
     "text": "Jaraknya dari Matahari pas, tidak terlalu panas dan tidak terlalu dingin, jadi air bisa tetap cair.",
     "para": 1,
     "start": 12.78,
     "end": 19.61
    },
    {
     "text": "Bumi punya satu bulan yang setia menemani.",
     "para": 2,
     "start": 19.61,
     "end": 23.03
    },
    {
     "text": "Kalau Merkurius dan Venus tadi?",
     "para": 2,
     "start": 23.03,
     "end": 25.85
    },
    {
     "text": "Nol!",
     "para": 2,
     "start": 25.85,
     "end": 26.68
    },
    {
     "text": "Jadi, jaga Bumi baik-baik ya, teman-teman.",
     "para": 3,
     "start": 26.68,
     "end": 28.74
    },
    {
     "text": "Kita belum punya planet cadangan!",
     "para": 3,
     "start": 28.74,
     "end": 30.93
    }
