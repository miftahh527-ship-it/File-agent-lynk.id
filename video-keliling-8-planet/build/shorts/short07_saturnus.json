   "sentences": [
    {
     "text": "Planet raksasa yang bisa mengapung di air?",
     "para": 0,
     "start": 0.45,
     "end": 2.92
    },
    {
     "text": "Ada!",
     "para": 0,
     "start": 2.92,
     "end": 5.52
    },
    {
     "text": "Namanya Saturnus.",
     "para": 0,
     "start": 5.52,
     "end": 6.84
    },
    {
     "text": "Saturnus memang besar, tapi sangat ringan untuk ukurannya.",
     "para": 1,
     "start": 6.84,
     "end": 9.46
    },
    {
     "text": "Kepadatannya lebih rendah dari air.",
     "para": 1,
     "start": 9.46,
     "end": 11.85
    },
    {
     "text": "Jadi kalau ada bak mandi sebesar itu, Saturnus bisa mengapung!",
     "para": 1,
     "start": 11.85,
     "end": 16.97
    },
    {
     "text": "Tentu ini cuma bayangan, karena bak mandi sebesar itu tidak ada.",
     "para": 1,
     "start": 16.97,
     "end": 21.03
    },
    {
     "text": "Cincin Saturnus yang cantik itu terbuat terutama dari bongkahan es, ada yang sekecil butiran debu, sampai sebesar rumah.",
     "para": 2,
     "start": 21.03,
     "end": 28.96
    },
    {
     "text": "Dan inilah juara bulan terbanyak!",
     "para": 3,
     "start": 28.96,
     "end": 31.55
    },
    {
     "text": "Per Maret 2025, Saturnus punya 274 bulan yang sudah diketahui.",
     "para": 3,
     "start": 31.55,
     "end": 37.52
    },
    {
     "text": "Jauh lebih banyak dari Jupiter!",
     "para": 3,
     "start": 37.52,
     "end": 39.97
    }
   ],
