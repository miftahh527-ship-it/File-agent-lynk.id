   "sentences": [
    {
     "text": "Ada badai yang sudah berputar ratusan tahun, dan lebih besar dari Bumi.",
     "para": 0,
     "start": 0.45,
     "end": 6.25
    },
    {
     "text": "Di mana?",
     "para": 0,
     "start": 6.25,
     "end": 7.49
    },
    {
     "text": "Di Jupiter!",
     "para": 0,
     "start": 7.49,
     "end": 8.13
    },
    {
     "text": "Jupiter adalah planet terbesar di tata surya.",
     "para": 1,
     "start": 8.13,
     "end": 10.53
    },
    {
     "text": "Lebih dari 1.000 Bumi bisa masuk ke dalamnya!",
     "para": 1,
     "start": 10.53,
     "end": 13.84
    },
    {
     "text": "Bintik merah di Jupiter itu sebenarnya badai raksasa, namanya Bintik Merah Raksasa.",
     "para": 2,
     "start": 13.84,
     "end": 19.23
    },
    {
     "text": "Badai ini sudah ada setidaknya sejak tahun 1800-an.",
     "para": 2,
     "start": 19.23,
     "end": 23.41
    },
    {
     "text": "Sekarang lebarnya sekitar 1,3 kali lebar Bumi.",
     "para": 2,
     "start": 23.41,
     "end": 27.42
    },
    {
     "text": "Dulu malah lebih besar, tapi pelan-pelan menyusut.",
     "para": 2,
     "start": 27.42,
     "end": 30.71
    },
    {
     "text": "Jupiter juga punya lebih dari 90 bulan.",
     "para": 3,
     "start": 30.71,
     "end": 34.21
    },
    {
     "text": "Tapi tunggu dulu, ada planet yang punya lebih banyak lagi!",
